# syntax=docker/dockerfile:1.7
FROM node:22.14-bookworm-slim AS dependencies
WORKDIR /app
ENV CI=true
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci --ignore-scripts --workspace @atlas/contracts --workspace @atlas/api --include-workspace-root

FROM dependencies AS build
COPY tsconfig.base.json ./
COPY packages/contracts packages/contracts
COPY apps/api apps/api
RUN npm run build --workspace @atlas/contracts \
  && npm run prisma:generate --workspace @atlas/api \
  && npm run build --workspace @atlas/api

FROM node:22.14-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN groupadd --system --gid 1001 atlas \
  && useradd --system --uid 1001 --gid atlas atlas
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=build /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/prisma ./apps/api/prisma
COPY --from=build /app/apps/api/prisma.config.ts ./apps/api/prisma.config.ts
RUN npm prune --ignore-scripts --omit=dev --workspace @atlas/contracts --workspace @atlas/api --include-workspace-root \
  && chown -R atlas:atlas /app
USER atlas
EXPOSE 4000
WORKDIR /app/apps/api
CMD ["node", "dist/main.js"]
