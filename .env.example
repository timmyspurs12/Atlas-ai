# Shared local development configuration
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000/v1
DATABASE_URL=postgresql://atlas:atlas_dev_only@localhost:5432/atlas?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-an-independent-32-character-secret
FIELD_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
APP_WEB_URL=http://localhost:8081
LOG_LEVEL=debug

# Mobile public build-time values
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_DEMO_MODE=true

# Optional integrations — adapters remain disabled until configured
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
APPLE_CLIENT_ID=com.atlasai.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
SENTRY_DSN=
