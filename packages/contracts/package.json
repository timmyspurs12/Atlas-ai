{
  "name": "@atlas/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./location": {
      "types": "./dist/location.d.ts",
      "default": "./dist/location.js"
    },
    "./friends": {
      "types": "./dist/friends.d.ts",
      "default": "./dist/friends.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "vitest": "^4.0.0"
  }
}
