{
  "name": "@atlas/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@atlas/contracts": "*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "*",
    "@expo/vector-icons": "^15.0.0",
    "@hookform/resolvers": "^5.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@reduxjs/toolkit": "^2.8.2",
    "@rnmapbox/maps": "^10.3.5",
    "@tanstack/react-query": "^5.85.5",
    "date-fns": "^4.1.0",
    "expo": "~57.0.11",
    "expo-apple-authentication": "*",
    "expo-audio": "*",
    "expo-auth-session": "*",
    "expo-blur": "*",
    "expo-constants": "*",
    "expo-crypto": "*",
    "expo-device": "*",
    "expo-font": "*",
    "expo-haptics": "*",
    "expo-image": "*",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "*",
    "expo-linking": "*",
    "expo-location": "~57.0.8",
    "expo-network": "*",
    "expo-notifications": "~57.0.9",
    "expo-secure-store": "*",
    "expo-splash-screen": "*",
    "expo-status-bar": "*",
    "expo-task-manager": "~57.0.8",
    "expo-web-browser": "*",
    "lucide-react-native": "^0.536.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "*",
    "react-native-svg": "15.15.4",
    "react-native-web": "*",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.2.0",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native|@react-navigation|expo|expo-.*|@expo/.*|@reduxjs/toolkit|redux|react-redux|immer|react-native-svg|lucide-react-native))"
    ]
  }
