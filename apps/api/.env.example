NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://atlas:atlas_dev_only@localhost:5432/atlas?schema=public
REDIS_URL=redis://localhost:6379
# Single-instance Phase 0 hosting only: skips the Socket.IO Redis adapter and
# stops /health/ready requiring Redis. MUST run exactly one API instance. See docs/free-tier-hosting.md
REDIS_OPTIONAL=false
JWT_ACCESS_SECRET=generate-a-unique-random-secret-of-at-least-32-characters
REFRESH_TOKEN_PEPPER=generate-a-different-random-secret-of-at-least-32-characters
FIELD_ENCRYPTION_KEY=generate-a-third-different-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://localhost:4173,http://127.0.0.1:4173
APP_WEB_URL=http://localhost:8081
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=

# --- Testing SOS delivery without paying a provider ---
# With no Twilio/Resend/FCM credentials the matching channel cannot send. Previously it
# returned false with NO log line, so the composed alert silently vanished: untestable without
# paying a provider, and in production a typo in TWILIO_ACCOUNT_SID would silently stop every
# emergency SMS with nothing to diagnose it from.
# Unconfigured channels now always warn. Set this true to also log the exact copy each channel
# WOULD have sent, so the whole SOS path can be exercised at zero cost.
# Recipients are masked and coordinates are never logged. Leave false in production: alert copy
# is personal data.
DELIVERY_DRY_RUN=false
APPLE_CLIENT_ID=ai.atlas.mobile
GOOGLE_CLIENT_IDS=

# --- Geo proxy: keyless public providers (routing, geocoding, weather) ---
# Base URLs are OPERATOR configuration, never client input. Point them at self-hosted
# OSRM/Nominatim instances in Phase 1+. The User-Agent is required by OpenStreetMap policy.
GEO_PROXY_ENABLED=true
GEO_PROXY_USER_AGENT=AtlasAI/0.1 (+https://github.com/timmyspurs12/Atlas-ai)
GEO_PROXY_DAILY_BUDGET=2000
GEO_PROXY_OSRM_CAR_BASE_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
GEO_PROXY_OSRM_BIKE_BASE_URL=https://routing.openstreetmap.de/routed-bike/route/v1/bike
GEO_PROXY_OSRM_FOOT_BASE_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot
GEO_PROXY_PHOTON_BASE_URL=https://photon.komoot.io
GEO_PROXY_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEO_PROXY_OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Hard ceiling for the SOS place lookup. Ordinary geo calls allow 12 s; an emergency must not.
# Exceeding it degrades the alert to coordinates-only, it never blocks delivery.
GEO_EMERGENCY_TIMEOUT_MS=2000
