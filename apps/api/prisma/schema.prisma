generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  BUSINESS_ADMIN
  DISPATCHER
  SECURITY_OPERATOR
  TRANSIT_EDITOR
  TRANSIT_REVIEWER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum LocationShareStatus {
  ACTIVE
  PAUSED
  REVOKED
  EXPIRED
}

enum LocationPrecision {
  PRECISE
  APPROXIMATE
}

enum TripStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TripSource {
  AUTOMATIC
  MANUAL
  IMPORTED
}

enum ConversationType {
  DIRECT
  GROUP
  SUPPORT
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  LOCATION
  SYSTEM
}

enum MessageReceiptStatus {
  DELIVERED
  READ
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  ARRIVAL
  DEPARTURE
  SOS
  SOS_RESOLVED
  CHAT
  SHARE_STARTED
  SHARE_ENDED
  SECURITY
  SUBSCRIPTION
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

enum EmergencyStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

enum GeofenceType {
  HOME
  OFFICE
  SCHOOL
  GYM
  CUSTOM
}

enum GeofenceEventType {
  ARRIVAL
  DEPARTURE
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SubscriptionPlan {
  FREE
  PLUS
  FAMILY
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum VerificationPurpose {
  VERIFY_EMAIL
  VERIFY_PHONE
  RESET_PASSWORD
  VERIFY_DEVICE
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum AiRole {
  USER
  ASSISTANT
  SYSTEM
}

enum TransitFareTimeBand {
  ANYTIME
  MORNING_PEAK
  EVENING_PEAK
  OFF_PEAK
  NIGHT
  WEEKEND
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String?    @unique @db.VarChar(320)
  phone               String?    @unique @db.VarChar(32)
  passwordHash        String?    @db.VarChar(255)
  role                UserRole   @default(USER)
  status              UserStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?  @db.Timestamptz(3)
  phoneVerifiedAt     DateTime?  @db.Timestamptz(3)
  lastSeenAt          DateTime?  @db.Timestamptz(3)
  termsVersion        String     @db.VarChar(20)
  termsAcceptedAt     DateTime   @db.Timestamptz(3)
  deletionScheduledAt DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?  @db.Timestamptz(3)

  profile                 Profile?
  sentFriendRequests      Friendship[]             @relation("FriendshipRequester")
  receivedFriendRequests  Friendship[]             @relation("FriendshipAddressee")
  blocksInitiated         UserBlock[]              @relation("Blocker")
  blocksReceived          UserBlock[]              @relation("BlockedUser")
  locationSharesOwned     LocationShare[]          @relation("ShareOwner")
  locationSharesReceived  LocationShare[]          @relation("ShareRecipient")
  locationSharesRevoked   LocationShare[]          @relation("ShareRevoker")
  liveLocation            LiveLocation?
  trips                   Trip[]
  messages                Message[]                @relation("MessageSender")
  messageReceipts         MessageReceipt[]
  conversationMemberships ConversationMember[]
  conversationsCreated    Conversation[]           @relation("ConversationCreator")
  notifications           Notification[]           @relation("NotificationRecipient")
  notificationPreference  NotificationPreference?
  notificationsActed      Notification[]           @relation("NotificationActor")
  emergencyContactsOwned  EmergencyContact[]       @relation("EmergencyOwner")
  emergencyContactFor     EmergencyContact[]       @relation("EmergencyContactUser")
  geofencesOwned          Geofence[]               @relation("GeofenceOwner")
  geofencesAsSubject      Geofence[]               @relation("GeofenceSubject")
  devices                 Device[]
  sessions                Session[]
  subscriptions           Subscription[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  verificationChallenges  VerificationChallenge[]
  authIdentities          AuthIdentity[]
  sosAlerts               SosAlert[]               @relation("SosInitiator")
  sosRecipients           SosRecipient[]
  aiConversations         AiConversation[]
  transitRoutesCreated    TransitRoute[]           @relation("TransitRouteCreator")
  transitRoutesPublished  TransitRoute[]           @relation("TransitRoutePublisher")
  transitFareObservations TransitFareObservation[] @relation("TransitFareRecorder")

  @@index([status, deletedAt])
  @@map("users")
}

model Profile {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String            @unique @db.Uuid
  displayName           String            @db.VarChar(60)
  handle                String?           @unique @db.VarChar(30)
  avatarUrl             String?           @db.VarChar(2048)
  bio                   String?           @db.VarChar(240)
  timezone              String            @default("UTC") @db.VarChar(64)
  locale                String            @default("en") @db.VarChar(16)
  isDiscoverable        Boolean           @default(true)
  showOnlineStatus      Boolean           @default(true)
  defaultSharePrecision LocationPrecision @default(PRECISE)
  analyticsConsentAt    DateTime?         @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime?         @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@index([deletedAt])
  @@map("profiles")
}

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @db.Uuid
  addresseeId String           @db.Uuid
  pairKey     String           @unique @db.VarChar(73)
  status      FriendshipStatus @default(PENDING)
  respondedAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?        @db.Timestamptz(3)

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status, deletedAt])
  @@index([requesterId, status, deletedAt])
  @@map("friendships")
}

model UserBlock {
  id            String    @id @default(uuid()) @db.Uuid
  blockerId     String    @db.Uuid
  blockedUserId String    @db.Uuid
  reason        String?   @db.VarChar(200)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)

  blocker     User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser User @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId, deletedAt])
  @@map("user_blocks")
}

model LocationShare {
  id              String              @id @default(uuid()) @db.Uuid
  ownerId         String              @db.Uuid
  recipientId     String              @db.Uuid
  revokedById     String?             @db.Uuid
  status          LocationShareStatus @default(ACTIVE)
  precision       LocationPrecision   @default(PRECISE)
  shareBattery    Boolean             @default(true)
  shareSpeed      Boolean             @default(true)
  allowGeofences  Boolean             @default(false)
  startsAt        DateTime            @db.Timestamptz(3)
  expiresAt       DateTime            @db.Timestamptz(3)
  endedAt         DateTime?           @db.Timestamptz(3)
  lastBroadcastAt DateTime?           @db.Timestamptz(3)
  version         Int                 @default(1)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?           @db.Timestamptz(3)

  owner     User  @relation("ShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient User  @relation("ShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  revokedBy User? @relation("ShareRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([ownerId, status, expiresAt, deletedAt])
  @@index([recipientId, status, expiresAt, deletedAt])
  @@map("location_shares")
}

model LiveLocation {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  sourceDeviceId String?   @db.Uuid
  latitude       Decimal   @db.Decimal(10, 7)
  longitude      Decimal   @db.Decimal(10, 7)
  altitudeM      Decimal?  @db.Decimal(8, 2)
  accuracyM      Decimal   @db.Decimal(8, 2)
  headingDeg     Decimal?  @db.Decimal(6, 2)
  speedMps       Decimal?  @db.Decimal(7, 2)
  batteryPct     Int?
  isCharging     Boolean?
  isMocked       Boolean   @default(false)
  sequence       BigInt
  recordedAt     DateTime  @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDevice Device? @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull)

  @@index([recordedAt])
  @@index([deletedAt])
  @@map("live_locations")
}

model Trip {
  id                 String     @id @default(uuid()) @db.Uuid
  userId             String     @db.Uuid
  status             TripStatus @default(ACTIVE)
  source             TripSource @default(AUTOMATIC)
  title              String?    @db.VarChar(120)
  startedAt          DateTime   @db.Timestamptz(3)
  endedAt            DateTime?  @db.Timestamptz(3)
  startLabel         String?    @db.VarChar(200)
  endLabel           String?    @db.VarChar(200)
  distanceM          Int        @default(0)
  durationSeconds    Int        @default(0)
  averageSpeedMps    Decimal?   @db.Decimal(7, 2)
  maxSpeedMps        Decimal?   @db.Decimal(7, 2)
  carbonEstimateG    Int?
  aiSummary          String?    @db.Text
  summaryGeneratedAt DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?  @db.Timestamptz(3)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  points TripPoint[]

  @@index([userId, startedAt(sort: Desc), deletedAt])
  @@index([status, updatedAt])
  @@map("trips")
}

model TripPoint {
  id             String    @id @default(uuid()) @db.Uuid
  tripId         String    @db.Uuid
  sourceDeviceId String?   @db.Uuid
  latitude       Decimal   @db.Decimal(10, 7)
  longitude      Decimal   @db.Decimal(10, 7)
  altitudeM      Decimal?  @db.Decimal(8, 2)
  accuracyM      Decimal   @db.Decimal(8, 2)
  headingDeg     Decimal?  @db.Decimal(6, 2)
  speedMps       Decimal?  @db.Decimal(7, 2)
  sequence       Int
  recordedAt     DateTime  @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  trip         Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sourceDevice Device? @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull)

  @@unique([tripId, sequence])
  @@index([tripId, recordedAt])
  @@map("trip_points")
}

model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  type          ConversationType @default(DIRECT)
  directPairKey String?          @unique @db.VarChar(73)
  createdById   String?          @db.Uuid
  title         String?          @db.VarChar(100)
  avatarUrl     String?          @db.VarChar(2048)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?        @db.Timestamptz(3)

  createdBy User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ConversationMember[]
  messages  Message[]

  @@index([updatedAt(sort: Desc), deletedAt])
  @@map("conversations")
}

model ConversationMember {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @db.Timestamptz(3)
  mutedUntil     DateTime? @db.Timestamptz(3)
  lastReadAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, deletedAt])
  @@map("conversation_members")
}

model Message {
  id                   String      @id @default(uuid()) @db.Uuid
  conversationId       String      @db.Uuid
  senderId             String      @db.Uuid
  clientMessageId      String      @db.Uuid
  type                 MessageType @default(TEXT)
  bodyCiphertext       Bytes?
  bodyPreview          String?     @db.VarChar(160)
  encryptionKeyVersion Int         @default(1)
  replyToMessageId     String?     @db.Uuid
  sentAt               DateTime    @db.Timestamptz(3)
  editedAt             DateTime?   @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?   @db.Timestamptz(3)

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?            @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]           @relation("MessageReplies")
  receipts     MessageReceipt[]
  attachments  MessageAttachment[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, sentAt(sort: Desc), deletedAt])
  @@map("messages")
}

model MessageAttachment {
  id         String    @id @default(uuid()) @db.Uuid
  messageId  String    @db.Uuid
  storageKey String    @db.VarChar(512)
  mimeType   String    @db.VarChar(100)
  sizeBytes  Int
  durationMs Int?
  width      Int?
  height     Int?
  checksum   String    @db.VarChar(128)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, deletedAt])
  @@map("message_attachments")
}

model MessageReceipt {
  id         String               @id @default(uuid()) @db.Uuid
  messageId  String               @db.Uuid
  userId     String               @db.Uuid
  status     MessageReceiptStatus
  occurredAt DateTime             @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime?            @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, status])
  @@index([userId, occurredAt(sort: Desc)])
  @@map("message_receipts")
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @db.Uuid
  actorId     String?             @db.Uuid
  type        NotificationType
  channel     NotificationChannel @default(IN_APP)
  title       String              @db.VarChar(120)
  body        String              @db.VarChar(500)
  data        Json?
  readAt      DateTime?           @db.Timestamptz(3)
  deliveredAt DateTime?           @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?           @db.Timestamptz(3)

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt(sort: Desc), deletedAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  pushEnabled     Boolean   @default(true)
  friendRequests  Boolean   @default(true)
  locationSharing Boolean   @default(true)
  geofenceAlerts  Boolean   @default(true)
  chatMessages    Boolean   @default(true)
  sosAlerts       Boolean   @default(true)
  weeklyReports   Boolean   @default(true)
  productUpdates  Boolean   @default(false)
  quietHours      Json?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@map("notification_preferences")
}

model EmergencyContact {
  id            String    @id @default(uuid()) @db.Uuid
  ownerId       String    @db.Uuid
  contactUserId String?   @db.Uuid
  name          String    @db.VarChar(80)
  phone         String?   @db.VarChar(32)
  email         String?   @db.VarChar(320)
  relationship  String?   @db.VarChar(40)
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime? @db.Timestamptz(3)
  priority      Int       @default(0)
  notifyPush    Boolean   @default(true)
  notifySms     Boolean   @default(false)
  notifyEmail   Boolean   @default(false)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)

  owner       User  @relation("EmergencyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactUser User? @relation("EmergencyContactUser", fields: [contactUserId], references: [id], onDelete: SetNull)

  @@index([ownerId, priority, deletedAt])
  @@map("emergency_contacts")
}

model SosAlert {
  id              String          @id @default(uuid()) @db.Uuid
  initiatorId     String          @db.Uuid
  status          EmergencyStatus @default(ACTIVE)
  clientRequestId String          @unique @db.Uuid
  latitude        Decimal         @db.Decimal(10, 7)
  longitude       Decimal         @db.Decimal(10, 7)
  accuracyM       Decimal         @db.Decimal(8, 2)
  message         String?         @db.VarChar(500)
  publicTokenHash String?         @unique @db.VarChar(128)
  publicExpiresAt DateTime?       @db.Timestamptz(3)
  acknowledgedAt  DateTime?       @db.Timestamptz(3)
  resolvedAt      DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?       @db.Timestamptz(3)

  initiator  User           @relation("SosInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  recipients SosRecipient[]

  @@index([initiatorId, status, createdAt(sort: Desc)])
  @@map("sos_alerts")
}

model SosRecipient {
  id             String    @id @default(uuid()) @db.Uuid
  sosAlertId     String    @db.Uuid
  userId         String?   @db.Uuid
  destination    String?   @db.VarChar(320)
  channels       Json
  deliveryState  Json?
  acknowledgedAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  alert SosAlert @relation(fields: [sosAlertId], references: [id], onDelete: Cascade)
  user  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sosAlertId, deletedAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("sos_recipients")
}

model Geofence {
  id                String       @id @default(uuid()) @db.Uuid
  ownerId           String       @db.Uuid
  subjectUserId     String       @db.Uuid
  type              GeofenceType @default(CUSTOM)
  name              String       @db.VarChar(80)
  latitude          Decimal      @db.Decimal(10, 7)
  longitude         Decimal      @db.Decimal(10, 7)
  radiusM           Int
  notifyOnArrival   Boolean      @default(true)
  notifyOnDeparture Boolean      @default(true)
  isEnabled         Boolean      @default(true)
  schedule          Json?
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?    @db.Timestamptz(3)

  owner       User            @relation("GeofenceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  subjectUser User            @relation("GeofenceSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  events      GeofenceEvent[]
  state       GeofenceState?

  @@index([ownerId, isEnabled, deletedAt])
  @@index([subjectUserId, isEnabled, deletedAt])
  @@map("geofences")
}

model GeofenceEvent {
  id         String            @id @default(uuid()) @db.Uuid
  geofenceId String            @db.Uuid
  type       GeofenceEventType
  latitude   Decimal           @db.Decimal(10, 7)
  longitude  Decimal           @db.Decimal(10, 7)
  occurredAt DateTime          @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime?         @db.Timestamptz(3)

  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@index([geofenceId, occurredAt(sort: Desc)])
  @@map("geofence_events")
}

model GeofenceState {
  id          String    @id @default(uuid()) @db.Uuid
  geofenceId  String    @unique @db.Uuid
  isInside    Boolean
  evaluatedAt DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@index([evaluatedAt])
  @@map("geofence_states")
}

model Device {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  installationId String         @db.VarChar(128)
  platform       DevicePlatform
  name           String         @db.VarChar(100)
  appVersion     String         @db.VarChar(30)
  osVersion      String?        @db.VarChar(30)
  pushToken      String?        @db.VarChar(512)
  pushEnabled    Boolean        @default(true)
  trustedAt      DateTime?      @db.Timestamptz(3)
  lastSeenAt     DateTime       @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?      @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      Session[]
  liveLocations LiveLocation[]
  tripPoints    TripPoint[]

  @@unique([userId, installationId])
  @@index([pushToken])
  @@index([userId, deletedAt])
  @@map("devices")
}

model Session {
  id                       String        @id @default(uuid()) @db.Uuid
  userId                   String        @db.Uuid
  deviceId                 String        @db.Uuid
  status                   SessionStatus @default(ACTIVE)
  refreshTokenHash         String        @db.VarChar(128)
  previousRefreshTokenHash String?       @db.VarChar(128)
  tokenFamily              String        @db.Uuid
  generation               Int           @default(1)
  ipHash                   String?       @db.VarChar(128)
  userAgent                String?       @db.VarChar(512)
  lastUsedAt               DateTime      @db.Timestamptz(3)
  expiresAt                DateTime      @db.Timestamptz(3)
  revokedAt                DateTime?     @db.Timestamptz(3)
  revokeReason             String?       @db.VarChar(100)
  createdAt                DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt                DateTime?     @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([tokenFamily])
  @@map("sessions")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  plan                   SubscriptionPlan   @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  provider               String?            @db.VarChar(40)
  providerCustomerId     String?            @db.VarChar(255)
  providerSubscriptionId String?            @unique @db.VarChar(255)
  currentPeriodStart     DateTime?          @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  entitlements           Json               @default("{}")
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt              DateTime?          @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, deletedAt])
  @@map("subscriptions")
}

model AuditLog {
  id         String        @id @default(uuid()) @db.Uuid
  actorId    String?       @db.Uuid
  action     String        @db.VarChar(100)
  entityType String        @db.VarChar(80)
  entityId   String?       @db.Uuid
  severity   AuditSeverity @default(INFO)
  outcome    String        @db.VarChar(30)
  metadata   Json?
  ipHash     String?       @db.VarChar(128)
  userAgent  String?       @db.VarChar(512)
  requestId  String?       @db.VarChar(100)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime?     @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model VerificationChallenge {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @db.Uuid
  purpose          VerificationPurpose
  targetHash       String              @db.VarChar(128)
  targetCiphertext Bytes?
  codeHash         String              @db.VarChar(128)
  attempts         Int                 @default(0)
  expiresAt        DateTime            @db.Timestamptz(3)
  consumedAt       DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?           @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("verification_challenges")
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String       @db.VarChar(255)
  providerEmail   String?      @db.VarChar(320)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?    @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId, deletedAt])
  @@map("auth_identities")
}

model AiConversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String?   @db.VarChar(100)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions AiInteraction[]

  @@index([userId, updatedAt(sort: Desc), deletedAt])
  @@map("ai_conversations")
}

model AiInteraction {
  id                    String    @id @default(uuid()) @db.Uuid
  conversationId        String    @db.Uuid
  role                  AiRole
  content               String    @db.Text
  intent                String?   @db.VarChar(80)
  model                 String?   @db.VarChar(80)
  promptTokens          Int?
  completionTokens      Int?
  preciseLocationShared Boolean   @default(false)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime? @db.Timestamptz(3)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_interactions")
}

enum AdministrativeAreaType {
  COUNTRY
  STATE
  FCT
  LGA
  CITY
  TOWN
  DISTRICT
  WARD
  LOCALITY
}

enum TransitCoverageStatus {
  COMING_SOON
  DATA_COLLECTION
  BETA
  VERIFIED
  SUSPENDED
}

enum TransitMode {
  DANFO
  BRT
  CITY_BUS
  KOROPE
  KEKE
  SHARED_TAXI
  INTERCITY_BUS
  RAIL
  FERRY
  WALK
  OKADA
  OTHER
}

enum TransitPlaceType {
  STOP
  MOTOR_PARK
  TERMINAL
  STATION
  JUNCTION
  LANDMARK
  JETTY
  PICKUP_POINT
}

enum TransitRouteScope {
  URBAN
  INTERCITY
  REGIONAL
}

enum TransitRouteStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SUSPENDED
  RETIRED
}

enum TransitDirection {
  OUTBOUND
  INBOUND
  LOOP
  BIDIRECTIONAL
}

enum TransitReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum TransitDataSourceType {
  FIELD_SURVEY
  GOVERNMENT_AGENCY
  TRANSPORT_OPERATOR
  UNION_PARTNER
  INTERNAL_RESEARCH
}

enum TransitImportStatus {
  UPLOADED
  VALIDATING
  NEEDS_CORRECTION
  READY
  IMPORTED
  FAILED
}

enum TransitJourneyPreference {
  BALANCED
  CHEAPEST
  FASTEST
  FEWEST_TRANSFERS
  LEAST_WALKING
  FORMAL_TRANSIT
}

enum TransitServiceDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model AdministrativeArea {
  id             String                 @id @default(uuid()) @db.Uuid
  parentId       String?                @db.Uuid
  name           String                 @db.VarChar(120)
  normalizedName String                 @db.VarChar(120)
  slug           String                 @unique @db.VarChar(180)
  code           String?                @unique @db.VarChar(40)
  type           AdministrativeAreaType
  countryCode    String                 @default("NG") @db.Char(2)
  timezone       String                 @default("Africa/Lagos") @db.VarChar(64)
  latitude       Decimal?               @db.Decimal(10, 7)
  longitude      Decimal?               @db.Decimal(10, 7)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?              @db.Timestamptz(3)

  parent      AdministrativeArea?  @relation("AdministrativeAreaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    AdministrativeArea[] @relation("AdministrativeAreaHierarchy")
  coverage    TransitCoverage?
  dataSources TransitDataSource[]
  places      TransitPlace[]
  routes      TransitRoute[]

  @@unique([parentId, normalizedName, type])
  @@index([parentId, type, deletedAt])
  @@index([countryCode, type, isActive, deletedAt])
  @@index([normalizedName])
  @@map("administrative_areas")
}

model TransitCoverage {
  id             String                @id @default(uuid()) @db.Uuid
  areaId         String                @unique @db.Uuid
  status         TransitCoverageStatus @default(COMING_SOON)
  qualityScore   Int                   @default(0)
  dataVersion    Int                   @default(1)
  lastSurveyedAt DateTime?             @db.Timestamptz(3)
  lastVerifiedAt DateTime?             @db.Timestamptz(3)
  publishedAt    DateTime?             @db.Timestamptz(3)
  notes          String?               @db.Text
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?             @db.Timestamptz(3)

  area AdministrativeArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([status, deletedAt])
  @@index([qualityScore, status])
  @@map("transit_coverages")
}

model TransitDataSource {
  id               String                @id @default(uuid()) @db.Uuid
  areaId           String?               @db.Uuid
  name             String                @db.VarChar(160)
  type             TransitDataSourceType
  organization     String?               @db.VarChar(160)
  sourceUrl        String?               @db.VarChar(2048)
  licenseName      String?               @db.VarChar(120)
  licenseUrl       String?               @db.VarChar(2048)
  reliabilityScore Int                   @default(50)
  lastCheckedAt    DateTime?             @db.Timestamptz(3)
  isActive         Boolean               @default(true)
  notes            String?               @db.Text
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?             @db.Timestamptz(3)

  area             AdministrativeArea?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
  places           TransitPlace[]
  routes           TransitRoute[]
  fareObservations TransitFareObservation[]

  @@index([areaId, type, deletedAt])
  @@index([isActive, reliabilityScore])
  @@map("transit_data_sources")
}

model TransitPlace {
  id                        String              @id @default(uuid()) @db.Uuid
  areaId                    String              @db.Uuid
  sourceId                  String?             @db.Uuid
  code                      String              @unique @db.VarChar(60)
  name                      String              @db.VarChar(160)
  normalizedName            String              @db.VarChar(160)
  type                      TransitPlaceType
  latitude                  Decimal             @db.Decimal(10, 7)
  longitude                 Decimal             @db.Decimal(10, 7)
  locationAccuracyM         Decimal?            @db.Decimal(8, 2)
  geohash                   String?             @db.VarChar(12)
  address                   String?             @db.VarChar(300)
  landmarkDescription       String?             @db.Text
  defaultBoardingDirections String?             @db.Text
  isWheelchairAccessible    Boolean?
  verificationStatus        TransitReviewStatus @default(PENDING)
  verifiedAt                DateTime?           @db.Timestamptz(3)
  isActive                  Boolean             @default(true)
  createdAt                 DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt                 DateTime?           @db.Timestamptz(3)

  area                 AdministrativeArea       @relation(fields: [areaId], references: [id], onDelete: Restrict)
  source               TransitDataSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  aliases              TransitPlaceAlias[]
  modes                TransitPlaceMode[]
  originRoutes         TransitRoute[]           @relation("TransitRouteOrigin")
  destinationRoutes    TransitRoute[]           @relation("TransitRouteDestination")
  routeStops           TransitRouteStop[]
  fareObservationsFrom TransitFareObservation[] @relation("TransitFareFromPlace")
  fareObservationsTo   TransitFareObservation[] @relation("TransitFareToPlace")

  @@index([areaId, type, isActive, deletedAt])
  @@index([areaId, normalizedName, deletedAt])
  @@index([normalizedName])
  @@index([geohash])
  @@index([latitude, longitude])
  @@index([verificationStatus, isActive])
  @@map("transit_places")
}

model TransitPlaceAlias {
  id              String    @id @default(uuid()) @db.Uuid
  placeId         String    @db.Uuid
  alias           String    @db.VarChar(160)
  normalizedAlias String    @db.VarChar(160)
  locale          String    @default("en-NG") @db.VarChar(16)
  isPrimary       Boolean   @default(false)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)

  place TransitPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, normalizedAlias, locale])
  @@index([normalizedAlias, locale, deletedAt])
  @@index([placeId, isPrimary, deletedAt])
  @@map("transit_place_aliases")
}

model TransitPlaceMode {
  id               String      @id @default(uuid()) @db.Uuid
  placeId          String      @db.Uuid
  mode             TransitMode
  boardingAllowed  Boolean     @default(true)
  alightingAllowed Boolean     @default(true)
  operatingNotes   String?     @db.Text
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?   @db.Timestamptz(3)

  place TransitPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, mode])
  @@index([mode, boardingAllowed, deletedAt])
  @@index([placeId, deletedAt])
  @@map("transit_place_modes")
}

model TransitRoute {
  id                 String             @id @default(uuid()) @db.Uuid
  areaId             String             @db.Uuid
  sourceId           String?            @db.Uuid
  createdById        String             @db.Uuid
  publishedById      String?            @db.Uuid
  originPlaceId      String             @db.Uuid
  destinationPlaceId String             @db.Uuid
  code               String             @unique @db.VarChar(80)
  name               String             @db.VarChar(180)
  normalizedName     String             @db.VarChar(180)
  scope              TransitRouteScope
  mode               TransitMode
  status             TransitRouteStatus @default(DRAFT)
  direction          TransitDirection
  destinationSign    String?            @db.VarChar(180)
  operatorName       String?            @db.VarChar(180)
  publicDescription  String?            @db.Text
  boardingSummary    String?            @db.Text
  durationMinMinutes Int?
  durationMaxMinutes Int?
  dataVersion        Int                @default(1)
  confidenceScore    Int                @default(0)
  lastVerifiedAt     DateTime?          @db.Timestamptz(3)
  submittedAt        DateTime?          @db.Timestamptz(3)
  publishedAt        DateTime?          @db.Timestamptz(3)
  retiredAt          DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?          @db.Timestamptz(3)

  area             AdministrativeArea       @relation(fields: [areaId], references: [id], onDelete: Restrict)
  source           TransitDataSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdBy        User                     @relation("TransitRouteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy      User?                    @relation("TransitRoutePublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  originPlace      TransitPlace             @relation("TransitRouteOrigin", fields: [originPlaceId], references: [id], onDelete: Restrict)
  destinationPlace TransitPlace             @relation("TransitRouteDestination", fields: [destinationPlaceId], references: [id], onDelete: Restrict)
  stops            TransitRouteStop[]
  segments         TransitSegment[]
  serviceWindows   TransitServiceWindow[]
  fareObservations TransitFareObservation[]

  @@index([areaId, status, mode, deletedAt])
  @@index([originPlaceId, destinationPlaceId, status])
  @@index([normalizedName])
  @@index([createdById, status, updatedAt])
  @@index([publishedAt, status])
  @@map("transit_routes")
}

model TransitRouteStop {
  id                    String    @id @default(uuid()) @db.Uuid
  routeId               String    @db.Uuid
  placeId               String    @db.Uuid
  stopOrder             Int
  platformName          String?   @db.VarChar(120)
  pickupAllowed         Boolean   @default(true)
  dropoffAllowed        Boolean   @default(true)
  isTimingPoint         Boolean   @default(false)
  boardingInstructions  String?   @db.Text
  alightingInstructions String?   @db.Text
  averageDwellSeconds   Int?
  distanceFromStartM    Int?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime? @db.Timestamptz(3)

  route            TransitRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  place            TransitPlace     @relation(fields: [placeId], references: [id], onDelete: Restrict)
  outgoingSegments TransitSegment[] @relation("TransitSegmentFromStop")
  incomingSegments TransitSegment[] @relation("TransitSegmentToStop")

  @@unique([routeId, stopOrder])
  @@index([placeId, routeId, deletedAt])
  @@index([routeId, pickupAllowed, dropoffAllowed])
  @@map("transit_route_stops")
}

model TransitSegment {
  id                 String    @id @default(uuid()) @db.Uuid
  routeId            String    @db.Uuid
  fromStopId         String    @db.Uuid
  toStopId           String    @db.Uuid
  segmentOrder       Int
  distanceM          Int?
  durationMinMinutes Int?
  durationMaxMinutes Int?
  fareMinKobo        Int?
  fareMaxKobo        Int?
  roadDescription    String?   @db.Text
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)

  route    TransitRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  fromStop TransitRouteStop @relation("TransitSegmentFromStop", fields: [fromStopId], references: [id], onDelete: Cascade)
  toStop   TransitRouteStop @relation("TransitSegmentToStop", fields: [toStopId], references: [id], onDelete: Cascade)

  @@unique([routeId, segmentOrder])
  @@unique([routeId, fromStopId, toStopId])
  @@index([fromStopId, toStopId])
  @@index([routeId, deletedAt])
  @@map("transit_segments")
}

model TransitServiceWindow {
  id                  String            @id @default(uuid()) @db.Uuid
  routeId             String            @db.Uuid
  day                 TransitServiceDay
  startMinute         Int
  endMinute           Int
  endsNextDay         Boolean           @default(false)
  frequencyMinMinutes Int?
  frequencyMaxMinutes Int?
  isApproximate       Boolean           @default(true)
  notes               String?           @db.Text
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?         @db.Timestamptz(3)

  route TransitRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, day, startMinute, endMinute])
  @@index([routeId, day, deletedAt])
  @@index([day, startMinute, endMinute])
  @@map("transit_service_windows")
}

model TransitFareObservation {
  id              String              @id @default(uuid()) @db.Uuid
  routeId         String              @db.Uuid
  sourceId        String              @db.Uuid
  recordedById    String              @db.Uuid
  fromPlaceId     String?             @db.Uuid
  toPlaceId       String?             @db.Uuid
  amountMinKobo   Int
  amountMaxKobo   Int
  currencyCode    String              @default("NGN") @db.Char(3)
  timeBand        TransitFareTimeBand @default(ANYTIME)
  confidenceScore Int                 @default(50)
  observedAt      DateTime            @db.Timestamptz(3)
  validUntil      DateTime?           @db.Timestamptz(3)
  evidenceFileKey String?             @db.VarChar(512)
  notes           String?             @db.Text
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?           @db.Timestamptz(3)

  route      TransitRoute      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  source     TransitDataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  recordedBy User              @relation("TransitFareRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  fromPlace  TransitPlace?     @relation("TransitFareFromPlace", fields: [fromPlaceId], references: [id], onDelete: SetNull)
  toPlace    TransitPlace?     @relation("TransitFareToPlace", fields: [toPlaceId], references: [id], onDelete: SetNull)

  @@index([routeId, observedAt(sort: Desc), deletedAt])
  @@index([fromPlaceId, toPlaceId, observedAt(sort: Desc)])
  @@index([sourceId, observedAt(sort: Desc)])
  @@index([validUntil, confidenceScore])
  @@map("transit_fare_observations")
}
